%% EngageMind user interaction flow (source of truth)
flowchart TB
  START([Open app])

  subgraph A["1. Access"]
    direction LR
    AUTH{Valid token?}
    REG["Register / login"]
    CHAT["Open chat"]
    AUTH -->|No| REG --> CHAT
    AUTH -->|Yes| CHAT
  end

  subgraph B["2. Add context"]
    direction LR
    NEW["Select conversation"]
    DOCS{Has documents?}
    UPLOAD["Upload file"]
    INDEX["Update FAISS index"]
    NEW --> DOCS
    DOCS -->|No| UPLOAD --> INDEX
  end

  subgraph C["3. Ask and remember"]
    direction LR
    ASK["Ask question"]
    RAG["Retrieve + answer"]
    SAVE["Save chat state"]
    ASK --> RAG --> SAVE
  end

  subgraph D["4. Optional training"]
    direction LR
    TRAIN["Start GPT-2 LoRA job"]
    STATUS["Poll status"]
    TRAIN --> STATUS
  end

  END([Done])

  START --> AUTH
  CHAT --> NEW
  DOCS -->|Yes| ASK
  INDEX --> ASK
  SAVE -->|"follow-up"| ASK
  SAVE -->|"train"| TRAIN
  STATUS --> END
  SAVE -->|"stop"| END

  classDef state fill:#e0f2fe,stroke:#0369a1,color:#0c4a6e,stroke-width:1px;
  classDef action fill:#dcfce7,stroke:#15803d,color:#14532d,stroke-width:1px;
  classDef decision fill:#fef3c7,stroke:#b45309,color:#78350f,stroke-width:1px;

  class START,END state;
  class REG,CHAT,NEW,UPLOAD,INDEX,ASK,RAG,SAVE,TRAIN,STATUS action;
  class AUTH,DOCS decision;
